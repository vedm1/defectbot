# Copy to .env for local development, OR paste each value into Render
# Dashboard -> Environment -> Add Environment Variable.
#
# Never commit a real .env to git. The .gitignore should exclude it.

# --- Teams webhooks ---
# Outgoing Webhook security token shown by Teams when you create the bot.
# Used to HMAC-verify incoming requests from Teams.
TEAMS_WEBHOOK_SECRET=paste-the-base64-secret-from-teams-here

# Incoming Webhook URL for the "UAT Defects" channel. Used by the
# background worker to post the final triage result back into the channel.
TEAMS_INCOMING_WEBHOOK_URL=https://euromonitor.webhook.office.com/webhookb2/...

# --- Anthropic ---
# Generate at console.anthropic.com/settings/keys. Recommend a workspace
# spend cap of $20/month while in PoC.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- Azure DevOps ---
# Personal Access Token with "Work Items: Read & Write" scope.
# Created at dev.azure.com/euromonitor/_usersSettings/tokens.
# 90-day expiry recommended; rotate quarterly.
ADO_PAT=paste-the-pat-here
ADO_ORG=euromonitor
ADO_PROJECT=North Star
ADO_EPIC_ID=375255
ADO_ITERATION_PATH=North Star\PI4

# --- Server ---
# Render sets PORT automatically; locally we default to 8000.
PORT=8000
